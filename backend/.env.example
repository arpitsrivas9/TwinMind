AI_MAX_INPUT_CHARACTERS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_CONTEXT_MESSAGE_LIMIT=20
AI_REQUEST_WINDOW_MS=900000
AI_REQUEST_LIMIT=30

STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads/documents"
MAX_FILE_SIZE=26214400
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="gemini-embedding-001"
VECTOR_DB_URL="http://localhost:8000"
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.45
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

GRAPH_STORE_PROVIDER="hybrid"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="twinmindgraph"
GRAPH_MAX_TRAVERSAL_DEPTH=2
GRAPH_TRAVERSAL_NODE_LIMIT=30
