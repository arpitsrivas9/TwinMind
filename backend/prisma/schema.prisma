generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  conversations Conversation[]
  memories     Memory[]
  memorySettings MemorySettings?
  documents    Document[]
  graphEntities GraphEntity[]
  graphRelationships GraphRelationship[]
  trustedDevices TrustedDevice[]
  trustProfile TrustProfile?
  auditLogs    SecurityAuditLog[]

  @@map("users")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @db.VarChar(160)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  memories  Memory[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  status         MessageStatus @default(COMPLETED)
  content        String       @db.Text
  model          String?      @db.VarChar(120)
  createdAt      DateTime     @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memories       Memory[]
  citations      Citation[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id                   String       @id @default(cuid())
  userId               String
  type                 MemoryType
  content              String       @db.Text
  summary              String?      @db.VarChar(255)
  importance           Int          @default(5)
  confidence           Float        @default(0.9)
  sourceConversationId String?
  sourceMessageId      String?
  isActive             Boolean      @default(true)
  lastAccessedAt       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage        Message?     @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, isActive, importance])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("memories")
}

model MemorySettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  enabled       Boolean  @default(true)
  autoExtract   Boolean  @default(true)
  requireReview Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memory_settings")
}

enum MemoryType {
  USER_PREFERENCE
  GOAL
  PROJECT
  EPISODIC
  SEMANTIC
  CONVERSATION
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model Document {
  id               String         @id @default(cuid())
  userId           String
  filename         String         @db.VarChar(255)
  originalFilename String         @db.VarChar(255)
  mimeType         String         @db.VarChar(120)
  fileSize         Int
  storageKey       String         @db.VarChar(512)
  status           DocumentStatus @default(UPLOADED)
  processingError  String?        @db.Text
  pageCount        Int?
  checksum         String         @db.VarChar(64)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  processedAt      DateTime?

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks           DocumentChunk[]
  citations        Citation[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("documents")
}

model DocumentChunk {
  id           String     @id @default(cuid())
  documentId   String
  userId       String
  chunkIndex   Int
  content      String     @db.Text
  pageNumber   Int?
  slideNumber  Int?
  timestamp    String?    @db.VarChar(50)
  sectionTitle String?    @db.VarChar(255)
  tokenCount   Int        @default(0)
  embedding    Float[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations    Citation[]

  @@index([documentId, chunkIndex])
  @@index([userId])
  @@map("document_chunks")
}

model Citation {
  id            String         @id @default(cuid())
  messageId     String
  documentId    String
  chunkId       String?
  documentTitle String         @db.VarChar(255)
  pageNumber    Int?
  slideNumber   Int?
  timestamp     String?        @db.VarChar(50)
  snippet       String         @db.Text
  score         Float?
  createdAt     DateTime       @default(now())

  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk         DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([documentId])
  @@map("citations")
}

enum EntityType {
  USER
  PERSON
  PROJECT
  DOCUMENT
  TASK
  GOAL
  MEETING
  CONVERSATION
  MEMORY
  ORGANIZATION
  TOPIC
}

enum RelationshipType {
  OWNS
  WORKS_ON
  RELATED_TO
  CONTAINS
  HAS_DOCUMENT
  HAS_TASK
  HAS_GOAL
  ATTENDED
  DISCUSSED_IN
  MENTIONED_IN
  DERIVED_FROM
  REFERENCES
  DEPENDS_ON
  PART_OF
  ABOUT
  ASSOCIATED_WITH
  CREATED_FROM
  SUPPORTS
}

model GraphEntity {
  id             String            @id @default(cuid())
  userId         String
  type           EntityType
  name           String            @db.VarChar(255)
  normalizedName String            @db.VarChar(255)
  description    String?           @db.Text
  confidence     Float             @default(1.0)
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outEdges       GraphRelationship[] @relation("sourceEntity")
  inEdges        GraphRelationship[] @relation("targetEntity")

  @@unique([userId, type, normalizedName])
  @@index([userId, type])
  @@index([userId, normalizedName])
  @@map("graph_entities")
}

model GraphRelationship {
  id             String           @id @default(cuid())
  userId         String
  sourceEntityId String
  targetEntityId String
  type           RelationshipType
  confidence     Float            @default(0.9)
  sourceType     String?          @db.VarChar(64)
  sourceId       String?          @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntity   GraphEntity      @relation("sourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity   GraphEntity      @relation("targetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceEntityId, targetEntityId, type])
  @@index([userId, sourceEntityId])
  @@index([userId, targetEntityId])
  @@index([userId, type])
  @@index([userId, sourceType, sourceId])
  @@map("graph_relationships")
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  deviceKey  String   @db.VarChar(64)
  label      String   @db.VarChar(120)
  userAgent  String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(64)
  isTrusted  Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKey])
  @@index([userId, isTrusted])
  @@map("trusted_devices")
}

model TrustProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  autoLockMinutes        Int      @default(60)
  privacyShieldEnabled   Boolean  @default(false)
  voiceBiometricsEnabled Boolean  @default(false)
  faceBiometricsEnabled  Boolean  @default(false)
  osAuthEnabled          Boolean  @default(true)
  requireLiveness        Boolean  @default(false)
  voiceVoiceprintHash    String?  @db.VarChar(255)
  faceTemplateHash       String?  @db.VarChar(255)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_profiles")
}

model SecurityAuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   @db.VarChar(64)
  status     String   @db.VarChar(32)
  trustScore Int
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  details    String?  @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@map("security_audit_logs")
}

